# Server / CORS
FRONTEND_ORIGIN=http://localhost:5173

# LLM provider order for /api/report/*: LiteLLM → Gemini → Ollama.
# Set at least one provider below; leave others empty to use fallbacks.

# LiteLLM (default). Model must match your API key provider.
# Example: openai/gpt-4o-mini needs OPENAI_API_KEY.
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_API_KEY=
OPENAI_API_KEY=

# Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama fallback (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
